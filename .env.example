# KanchanFlow MCP server — example configuration.
# Copy to .env and edit. Never commit a real .env.
#
# Every variable below is OPTIONAL. With no .env at all the server runs as a
# public, read-only stdio server, which is the normal desktop-client setup.

# Transport: "stdio" (default) or "http".
#   stdio — the MCP host spawns this process and talks over stdin/stdout.
#   http  — Streamable HTTP, for a remote/hosted endpoint.
KANCHANFLOW_MCP_TRANSPORT=stdio

# HTTP transport only. Port to listen on.
KANCHANFLOW_MCP_PORT=3010

# HTTP transport only. Path the MCP endpoint is served from.
KANCHANFLOW_MCP_PATH=/mcp

# HTTP transport only. When set, every request must present
#   Authorization: Bearer <token>
# When unset the HTTP endpoint is public. The server is read-only either way:
# there are no write tools to protect. Set this if you host a private instance
# and want to keep casual traffic off it.
# KANCHANFLOW_MCP_AUTH_TOKEN=

# HTTP transport only. Requests allowed per IP per minute. 0 disables limiting.
KANCHANFLOW_MCP_RATE_LIMIT=120

# Log level: silent | error | warn | info | debug
KANCHANFLOW_MCP_LOG_LEVEL=info

# Absolute path to the reference/ folder. Defaults to the folder shipped with
# the package. Override only when running the reference set from elsewhere.
# KANCHANFLOW_REFERENCE_DIR=

# Path to the KanchanFlow website repository. Used ONLY by `npm run sync`,
# never at runtime. Defaults to ../KanchanFlow relative to this repo.
# KANCHANFLOW_REPO=../KanchanFlow
