# KanchanFlow MCP server — example configuration.
# Copy to .env and edit. Never commit a real .env.
#
# Every variable below is OPTIONAL. With no .env at all the server runs as a
# public, read-only stdio server, which is the normal desktop-client setup.

# Transport: "stdio" (default) or "http".
#   stdio — the MCP host spawns this process and talks over stdin/stdout.
#   http  — Streamable HTTP, for a remote/hosted endpoint.
KANCHANFLOW_MCP_TRANSPORT=stdio

# HTTP transport only. Port to listen on.
KANCHANFLOW_MCP_PORT=3010

# HTTP transport only. Path the MCP endpoint is served from.
KANCHANFLOW_MCP_PATH=/mcp

# HTTP transport only. When set, every request must present
#   Authorization: Bearer <token>
# When unset the HTTP endpoint is public. The server is read-only either way:
# there are no write tools to protect. Set this if you host a private instance
# and want to keep casual traffic off it.
# KANCHANFLOW_MCP_AUTH_TOKEN=

# HTTP transport only. Requests allowed per client per minute. 0 disables limiting.
KANCHANFLOW_MCP_RATE_LIMIT=60

# HTTP transport only. The rate limiter keys on the socket address unless this
# is 1/true/yes, in which case it keys on the RIGHT-most X-Forwarded-For hop.
# Turn it on only behind a reverse proxy that APPENDS that header; otherwise a
# caller can choose its own key. TRUST_PROXY is accepted as an alias.
# KANCHANFLOW_MCP_TRUST_PROXY=1

# HTTP transport only. Interface to bind. Defaults to loopback (127.0.0.1) so a
# dev server is not exposed to the LAN. Containers and remote hosts: 0.0.0.0.
# HOST is accepted as an alias.
# KANCHANFLOW_MCP_HOST=0.0.0.0

# HTTP transport only. Comma-separated Host names (port ignored) the MCP
# endpoint answers. * disables the check (not recommended).
# KANCHANFLOW_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.kanchanflow.com

# HTTP transport only. Comma-separated browser Origins allowed on the MCP
# endpoint. ":*" matches any port. * allows any origin. Requests without an
# Origin header (desktop and server clients) are unaffected.
# KANCHANFLOW_MCP_ALLOWED_ORIGINS=https://mcp.kanchanflow.com,https://kanchanflow.com,https://www.kanchanflow.com,http://localhost:*,http://127.0.0.1:*

# HTTP transport only. Public origin of this server, no path. Used to build the
# endpoint in /.well-known/mcp.json and on the homepage. Never derived from
# the request's Host header.
# KANCHANFLOW_MCP_PUBLIC_URL=https://mcp.kanchanflow.com

# Days after which tool responses mark the content mirror stale
# (source.stale = true, with a note to confirm on the website). Default 14.
# KANCHANFLOW_MCP_STALE_AFTER_DAYS=14

# Log level: silent | error | warn | info | debug
KANCHANFLOW_MCP_LOG_LEVEL=info

# Absolute path to the reference/ folder. Defaults to the folder shipped with
# the package. Override only when running the reference set from elsewhere.
# KANCHANFLOW_REFERENCE_DIR=

# Path to the KanchanFlow website repository. Used ONLY by `npm run sync`,
# never at runtime. Defaults to ../KanchanFlow relative to this repo.
# KANCHANFLOW_REPO=../KanchanFlow
