{
  "name": "kanchanflow-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol server for KanchanFlow \u2014 the RFQ-to-Order manufacturing CRM by Soor LLC. Read-only, truthful access to the KanchanFlow product catalog, pricing, integrations, roadmap and reference documentation.",
  "license": "MIT",
  "author": "Soor LLC",
  "mcpName": "com.kanchanflow/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeruLocal/KanchanFlow_MCP.git"
  },
  "bugs": {
    "url": "https://github.com/MeruLocal/KanchanFlow_MCP/issues"
  },
  "homepage": "https://kanchanflow.com/mcp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "kanchanflow-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data/site-mirror.json",
    "assets",
    "reference",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "mcp": "node dist/index.js",
    "mcp:dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dev": "tsx scripts/run-http.mjs ../src/index.ts",
    "dev:stdio": "tsx src/index.ts",
    "start:http": "node scripts/run-http.mjs ../dist/index.js",
    "sync": "node scripts/sync-content.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "check:versions": "node scripts/check-versions.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run check:versions && npm run test",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kanchanflow",
    "manufacturing-crm",
    "rfq",
    "quoting",
    "job-shop",
    "contract-manufacturing"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
